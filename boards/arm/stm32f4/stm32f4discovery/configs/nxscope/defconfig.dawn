# CONFIG_DAWN_LIFECYCLE_TEARDOWN is not set
CONFIG_DAWN=y
CONFIG_DAWN_DEBUG_ERROR=y
CONFIG_DAWN_DEBUG_WARN=y
CONFIG_DAWN_APPS_DAWN=y
CONFIG_DAWN_APPS_DAWN_STACKSIZE=8192
CONFIG_DAWN_APPS_EXAMPLE_DESC_FORMAT_YAML=y
CONFIG_DAWN_APPS_EXAMPLE_DESC_YAML_PATH="../../../descriptors/examples/stm32f4disco_nxscope.yaml"
CONFIG_DAWN_IO_SENSOR=y
CONFIG_DAWN_IO_BUTTONS=y
CONFIG_DAWN_IO_LEDS=y
CONFIG_DAWN_IO_NOTIFY=y
CONFIG_DAWN_PROG=y
CONFIG_DAWN_PROTO=y
CONFIG_DAWN_PROTO_NXSCOPE=y
CONFIG_DAWN_PROTO_NXSCOPE_SERIAL=y
CONFIG_DAWN_PROTO_NXSCOPE_SERIAL_PATH="/dev/ttyACM0"
CONFIG_DAWN_PROTO_NXSCOPE_NOTIFY=y
