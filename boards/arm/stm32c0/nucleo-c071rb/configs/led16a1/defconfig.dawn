# CONFIG_DAWN_LIFECYCLE_TEARDOWN is not set
CONFIG_DAWN=y
CONFIG_DAWN_APPS_DAWN=y
CONFIG_DAWN_APPS_DAWN_STACKSIZE=2048
CONFIG_DAWN_APPS_EXAMPLE_DESC_FORMAT_YAML=y
CONFIG_DAWN_APPS_EXAMPLE_DESC_YAML_PATH="../../../descriptors/examples/led16a1_serial_demo.yaml"
CONFIG_DAWN_IO_RGB_LED=y
CONFIG_DAWN_PROTO=y
CONFIG_DAWN_PROTO_SERIAL=y
CONFIG_DAWN_PROTO_SERIAL_PATH="/dev/ttyS0"
